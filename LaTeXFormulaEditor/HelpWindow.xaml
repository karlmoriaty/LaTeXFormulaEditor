<Window x:Class="LaTeXFormulaEditor.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="帮助文档" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="helpTitle" Grid.Row="0" Text="帮助文档" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="section1Title" Text="快速开始" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                <TextBlock x:Name="section1Content" TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="1. 在左侧的LaTeX代码编辑器中输入公式代码"/>
                    <LineBreak/>
                    <Run Text="2. 右侧会实时显示公式预览"/>
                    <LineBreak/>
                    <Run Text="3. 使用顶部工具栏快速插入常用符号和模板"/>
                </TextBlock>
                
                <TextBlock x:Name="section2Title" Text="工具栏说明" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                <TextBlock x:Name="section2Content" TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="• 基本符号：加减乘除、比较符号等"/>
                    <LineBreak/>
                    <Run Text="• 分数与方根：分数、平方根、n次方根"/>
                    <LineBreak/>
                    <Run Text="• 求和与积分：求和、积分、极限等"/>
                    <LineBreak/>
                    <Run Text="• 希腊字母：常用希腊字母"/>
                    <LineBreak/>
                    <Run Text="• 括号：各种括号"/>
                    <LineBreak/>
                    <Run Text="• 矩阵：2×2矩阵、矩阵括号、行列式"/>
                    <LineBreak/>
                    <Run Text="• 其他：上标、下标、导数、偏导等"/>
                </TextBlock>
                
                <TextBlock x:Name="section3Title" Text="样式设置" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                <TextBlock x:Name="section3Content" TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="• 公式颜色：设置公式的显示颜色"/>
                    <LineBreak/>
                    <Run Text="• 背景颜色：设置预览区域的背景颜色"/>
                    <LineBreak/>
                    <Run Text="• 字体：选择不同的字体"/>
                    <LineBreak/>
                    <Run Text="• 字号：调整公式的大小"/>
                </TextBlock>
                
                <TextBlock x:Name="section4Title" Text="图片识别" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                <TextBlock x:Name="section4Content" TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="• 点击'上传图片'按钮选择本地图片进行识别"/>
                    <LineBreak/>
                    <Run Text="• 点击'粘贴图片'按钮或按Ctrl+V粘贴剪贴板中的图片"/>
                </TextBlock>
                
                <TextBlock x:Name="section5Title" Text="快捷键" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                <TextBlock x:Name="section5Content" TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="• Ctrl + V：粘贴图片"/>
                    <LineBreak/>
                    <Run Text="• Ctrl + Z：撤销（编辑器中）"/>
                    <LineBreak/>
                    <Run Text="• Ctrl + Y：重做（编辑器中）"/>
                </TextBlock>
                
                <TextBlock x:Name="section6Title" Text="历史记录" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                <TextBlock x:Name="section6Content" TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="• 点击'历史记录'按钮查看和重用之前的公式"/>
                    <LineBreak/>
                    <Run Text="• 双击历史记录中的项目可以插入到编辑器"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        
        <Button x:Name="closeButton" Grid.Row="2" Content="关闭" Width="100" Height="35" Margin="0,20,0,0" HorizontalAlignment="Center" Click="CloseButton_Click"/>
    </Grid>
</Window>
