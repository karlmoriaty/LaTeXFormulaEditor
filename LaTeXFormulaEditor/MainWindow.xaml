<Window x:Class="LaTeXFormulaEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaTeXFormulaEditor"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ae="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
        mc:Ignorable="d"
        x:Name="mainWindow"
        Title="LaTeX 公式编辑器"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    
    <Window.Resources>
        <!-- 现代化按钮样式 -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000"
                                                Opacity="0.08"
                                                BlurRadius="4"
                                                ShadowDepth="1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主要操作按钮样式 -->
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#4F46E5"
                                                Opacity="0.25"
                                                BlurRadius="8"
                                                ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏按钮样式 -->
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分组标题样式 -->
        <Style TargetType="TextBlock" x:Key="GroupTitle">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="8,8,8,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏区域 -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                Opacity="0.05"
                                BlurRadius="8"
                                ShadowDepth="2"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="380">
                <StackPanel Orientation="Vertical" Margin="8">
                    <!-- 第一行：主要操作和语言 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="renderButton"
                                    Style="{StaticResource PrimaryButton}"
                                    ToolTip="渲染 LaTeX 公式 (Ctrl+R)"
                                    Click="RenderButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="renderButtonText" Text="渲染"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="clearButton"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="清空编辑器"
                                    Click="ClearButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑️" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="clearButtonText" Text="清空"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <Separator Width="16" Visibility="Collapsed"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBlock x:Name="languageLabel"
                                    Style="{StaticResource GroupTitle}"
                                    VerticalAlignment="Center"
                                    Margin="0"
                                    Text="语言:"/>
                            <ComboBox x:Name="languageComboBox"
                                    Width="120"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Margin="4,0"
                                    SelectionChanged="LanguageComboBox_SelectionChanged"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBlock x:Name="renderEngineLabel"
                                    Style="{StaticResource GroupTitle}"
                                    VerticalAlignment="Center"
                                    Margin="0"
                                    Text="渲染引擎:"/>
                            <ComboBox x:Name="renderEngineComboBox"
                                    Width="150"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Margin="4,0"
                                    SelectionChanged="RenderEngineComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                            <Button x:Name="uploadImageButton"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="从图片识别公式"
                                    Click="UploadImageButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📷" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="uploadImageButtonText" Text="图片识别"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="pasteImageButton"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="从剪贴板粘贴图片"
                                    Click="PasteImageButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="pasteImageButtonText" Text="粘贴图片"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="naturalLanguageButton"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="自然语言转 LaTeX"
                                    Click="NaturalLanguageButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💬" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="naturalLanguageButtonText" Text="自然语言"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="toNaturalLanguageButton"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="LaTeX 转自然语言"
                                    Click="ToNaturalLanguageButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="toNaturalLanguageButtonText" Text="转描述"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                            <Button x:Name="exportButton"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="导出公式"
                                    Click="ExportButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="exportButtonText" Text="导出"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="historyButton"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="查看历史记录"
                                    Click="HistoryButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📜" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="historyButtonText" Text="历史"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="helpButton"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="查看帮助"
                                    Click="HelpButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❓" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="helpButtonText" Text="帮助"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- 第二行：公式模板（可折叠分组） -->
                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <!-- 基础符号 -->
                        <Expander x:Name="basicSymbolsExpander" Header="基础符号" IsExpanded="True" Margin="0,0,8,8" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ToolBar x:Name="basicSymbolsToolbar" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button Style="{StaticResource ToolbarButton}" Content="+" ToolTip="加号" Tag="+" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="-" ToolTip="减号" Tag="-" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="×" ToolTip="乘号" Tag="\\times" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="÷" ToolTip="除号" Tag="\\div" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="·" ToolTip="点乘" Tag="\\cdot" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="±" ToolTip="正负号" Tag="\\pm" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="=" ToolTip="等号" Tag="=" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="≠" ToolTip="不等号" Tag="\\neq" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="≈" ToolTip="约等于" Tag="\\approx" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="≡" ToolTip="恒等于" Tag="\\equiv" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="&lt;" ToolTip="小于号" Tag="&lt;" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="&gt;" ToolTip="大于号" Tag="&gt;" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="≤" ToolTip="小于等于" Tag="\\leq" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="≥" ToolTip="大于等于" Tag="\\geq" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="≪" ToolTip="远小于" Tag="\\ll" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="≫" ToolTip="远大于" Tag="\\gg" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∞" ToolTip="无穷大" Tag="\\infty" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∝" ToolTip="正比于" Tag="\\propto" Click="InsertTemplate_Click"/>
                            </ToolBar>
                        </Expander>

                        <!-- 分数和根号 -->
                        <Expander x:Name="fractionsRootsExpander" Header="分数/根号" IsExpanded="True" Margin="0,0,8,8" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ToolBar x:Name="fractionsRootsToolbar" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button x:Name="fractionButton" Style="{StaticResource ToolbarButton}" Content="⅟" ToolTip="分数" Tag="\\frac{a}{b}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⅟+" ToolTip="连分数" Tag="\\cfrac{a}{b}" Click="InsertTemplate_Click"/>
                                <Button x:Name="sqrtButton" Style="{StaticResource ToolbarButton}" Content="√" ToolTip="平方根" Tag="\\sqrt{x}" Click="InsertTemplate_Click"/>
                                <Button x:Name="nthRootButton" Style="{StaticResource ToolbarButton}" Content="ⁿ√" ToolTip="n次方根" Tag="\\sqrt[n]{x}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="√²" ToolTip="平方" Tag="x^2" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="√³" ToolTip="立方" Tag="x^3" Click="InsertTemplate_Click"/>
                            </ToolBar>
                        </Expander>

                        <!-- 求和积分 -->
                        <Expander x:Name="sumsIntegralsExpander" Header="求和/积分" IsExpanded="True" Margin="0,0,8,8" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ToolBar x:Name="sumsIntegralsToolbar" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button x:Name="sumButton" Style="{StaticResource ToolbarButton}" Content="∑" ToolTip="求和" Tag="\\sum_{i=1}^{n}" Click="InsertTemplate_Click"/>
                                <Button x:Name="integralButton" Style="{StaticResource ToolbarButton}" Content="∫" ToolTip="积分" Tag="\\int_{a}^{b}" Click="InsertTemplate_Click"/>
                                <Button x:Name="doubleIntegralButton" Style="{StaticResource ToolbarButton}" Content="∬" ToolTip="二重积分" Tag="\\iint" Click="InsertTemplate_Click"/>
                                <Button x:Name="tripleIntegralButton" Style="{StaticResource ToolbarButton}" Content="∭" ToolTip="三重积分" Tag="\\iiint" Click="InsertTemplate_Click"/>
                                <Button x:Name="limitButton" Style="{StaticResource ToolbarButton}" Content="lim" ToolTip="极限" Tag="\\lim_{x \\to \\infty}" Click="InsertTemplate_Click"/>
                            </ToolBar>
                        </Expander>

                        <!-- 希腊字母 -->
                        <Expander x:Name="greekLettersExpander" Header="希腊字母" IsExpanded="False" Margin="0,0,8,8" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ToolBar x:Name="greekLettersToolbar" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button Style="{StaticResource ToolbarButton}" Content="α" ToolTip="小写Alpha" Tag="\\alpha" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Α" ToolTip="大写Alpha" Tag="\\Alpha" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="β" ToolTip="小写Beta" Tag="\\beta" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Β" ToolTip="大写Beta" Tag="\\Beta" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="γ" ToolTip="小写Gamma" Tag="\\gamma" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Γ" ToolTip="大写Gamma" Tag="\\Gamma" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="δ" ToolTip="小写Delta" Tag="\\delta" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Δ" ToolTip="大写Delta" Tag="\\Delta" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ε" ToolTip="小写Epsilon" Tag="\\epsilon" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ε" ToolTip="小写varepsilon" Tag="\\varepsilon" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ζ" ToolTip="小写Zeta" Tag="\\zeta" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="η" ToolTip="小写Eta" Tag="\\eta" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="θ" ToolTip="小写Theta" Tag="\\theta" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Θ" ToolTip="大写Theta" Tag="\\Theta" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ι" ToolTip="小写Iota" Tag="\\iota" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="κ" ToolTip="小写Kappa" Tag="\\kappa" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="λ" ToolTip="小写Lambda" Tag="\\lambda" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Λ" ToolTip="大写Lambda" Tag="\\Lambda" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="μ" ToolTip="小写Mu" Tag="\\mu" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ν" ToolTip="小写Nu" Tag="\\nu" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ξ" ToolTip="小写Xi" Tag="\\xi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Ξ" ToolTip="大写Xi" Tag="\\Xi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="π" ToolTip="小写Pi" Tag="\\pi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Π" ToolTip="大写Pi" Tag="\\Pi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ρ" ToolTip="小写Rho" Tag="\\rho" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="σ" ToolTip="小写Sigma" Tag="\\sigma" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Σ" ToolTip="大写Sigma" Tag="\\Sigma" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="τ" ToolTip="小写Tau" Tag="\\tau" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="υ" ToolTip="小写Upsilon" Tag="\\upsilon" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Υ" ToolTip="大写Upsilon" Tag="\\Upsilon" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="φ" ToolTip="小写Phi" Tag="\\phi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Φ" ToolTip="大写Phi" Tag="\\Phi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="φ" ToolTip="小写varphi" Tag="\\varphi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="χ" ToolTip="小写Chi" Tag="\\chi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ψ" ToolTip="小写Psi" Tag="\\psi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Ψ" ToolTip="大写Psi" Tag="\\Psi" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ω" ToolTip="小写Omega" Tag="\\omega" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="Ω" ToolTip="大写Omega" Tag="\\Omega" Click="InsertTemplate_Click"/>
                            </ToolBar>
                        </Expander>

                        <!-- 括号 -->
                        <Expander x:Name="bracketsExpander" Header="括号" IsExpanded="False" Margin="0,0,8,8" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ToolBar x:Name="bracketsToolbar" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button Style="{StaticResource ToolbarButton}" Content="()" ToolTip="圆括号" Tag="()" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="[]" ToolTip="方括号" Tag="[]" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="{}" ToolTip="花括号" Tag="\\{\\}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⟨⟩" ToolTip="角括号" Tag="\\langle\\rangle" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⌈⌉" ToolTip="上取整" Tag="\\lceil\\rceil" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⌊⌋" ToolTip="下取整" Tag="\\lfloor\\rfloor" Click="InsertTemplate_Click"/>
                            </ToolBar>
                        </Expander>

                        <!-- 集合和逻辑 -->
                        <Expander x:Name="setLogicExpander" Header="集合/逻辑" IsExpanded="False" Margin="0,0,8,8" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ToolBar x:Name="setLogicToolbar" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button Style="{StaticResource ToolbarButton}" Content="∅" ToolTip="空集" Tag="\\emptyset" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∈" ToolTip="属于" Tag="\\in" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∉" ToolTip="不属于" Tag="\\notin" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⊂" ToolTip="子集" Tag="\\subset" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⊆" ToolTip="子集或等于" Tag="\\subseteq" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⊃" ToolTip="超集" Tag="\\supset" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∪" ToolTip="并集" Tag="\\cup" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∩" ToolTip="交集" Tag="\\cap" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∀" ToolTip="全称量词" Tag="\\forall" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∃" ToolTip="存在量词" Tag="\\exists" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="¬" ToolTip="否定" Tag="\\neg" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∧" ToolTip="合取" Tag="\\land" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∨" ToolTip="析取" Tag="\\lor" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⇒" ToolTip="蕴含" Tag="\\Rightarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⇔" ToolTip="等价" Tag="\\Leftrightarrow" Click="InsertTemplate_Click"/>
                            </ToolBar>
                        </Expander>

                        <!-- 矩阵 -->
                        <Expander x:Name="matricesExpander" Header="矩阵" IsExpanded="False" Margin="0,0,8,8" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ToolBar x:Name="matricesToolbar" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button x:Name="matrix2x2Button" Style="{StaticResource ToolbarButton}" Content="□□" ToolTip="2×2矩阵" Tag="\\begin{matrix} a &amp; b \\\\ c &amp; d \\end{matrix}" Click="InsertTemplate_Click"/>
                                <Button x:Name="matrixBracketsButton" Style="{StaticResource ToolbarButton}" Content="[□]" ToolTip="矩阵括号" Tag="\\begin{pmatrix} a &amp; b \\\\ c &amp; d \\end{pmatrix}" Click="InsertTemplate_Click"/>
                                <Button x:Name="determinantButton" Style="{StaticResource ToolbarButton}" Content="|□|" ToolTip="行列式" Tag="\\begin{vmatrix} a &amp; b \\\\ c &amp; d \\end{vmatrix}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="|□|" ToolTip="矩阵范数" Tag="\\begin{Vmatrix} a &amp; b \\\\ c &amp; d \\end{Vmatrix}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="□⎪" ToolTip="增广矩阵" Tag="\\left(\\begin{array}{cc|c} a &amp; b &amp; c \\\\ d &amp; e &amp; f \\end{array}\\right)" Click="InsertTemplate_Click"/>
                            </ToolBar>
                        </Expander>

                        <!-- 箭头 -->
                        <Expander x:Name="arrowsExpander" Header="箭头" IsExpanded="False" Margin="0,0,8,8" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ToolBar x:Name="arrowsToolbar" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button Style="{StaticResource ToolbarButton}" Content="→" ToolTip="右箭头" Tag="\\rightarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="←" ToolTip="左箭头" Tag="\\leftarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="↔" ToolTip="双向箭头" Tag="\\leftrightarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⇒" ToolTip="右长箭头" Tag="\\Rightarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⇐" ToolTip="左长箭头" Tag="\\Leftarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⇔" ToolTip="双向长箭头" Tag="\\Leftrightarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="↑" ToolTip="上箭头" Tag="\\uparrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="↓" ToolTip="下箭头" Tag="\\downarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="↕" ToolTip="上下箭头" Tag="\\updownarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⟶" ToolTip="长右箭头" Tag="\\longrightarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⟵" ToolTip="长左箭头" Tag="\\longleftarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="↦" ToolTip="映射箭头" Tag="\\mapsto" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="⟼" ToolTip="长映射箭头" Tag="\\longmapsto" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="↪" ToolTip="单射箭头" Tag="\\hookrightarrow" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="↠" ToolTip="满射箭头" Tag="\\twoheadrightarrow" Click="InsertTemplate_Click"/>
                            </ToolBar>
                        </Expander>

                        <!-- 其他 -->
                        <Expander x:Name="otherExpander" Header="其他" IsExpanded="False" Margin="0,0,0,8" Padding="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ToolBar x:Name="otherToolbar" Background="Transparent" BorderThickness="0" Padding="0">
                                <Button x:Name="superscriptButton" Style="{StaticResource ToolbarButton}" Content="ˣ" ToolTip="上标" Tag="^{}" Click="InsertTemplate_Click"/>
                                <Button x:Name="subscriptButton" Style="{StaticResource ToolbarButton}" Content="ₓ" ToolTip="下标" Tag="_{}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="x₀" ToolTip="下标" Tag="x_0" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="xʸ" ToolTip="上标" Tag="x^y" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="xᵧ" ToolTip="上下标" Tag="x_y^z" Click="InsertTemplate_Click"/>
                                <Button x:Name="derivativeButton" Style="{StaticResource ToolbarButton}" Content="d/dx" ToolTip="导数" Tag="\\frac{d}{dx}" Click="InsertTemplate_Click"/>
                                <Button x:Name="partialDerivativeButton" Style="{StaticResource ToolbarButton}" Content="∂/∂x" ToolTip="偏导数" Tag="\\frac{\\partial}{\\partial x}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="∂²/∂x²" ToolTip="二阶偏导" Tag="\\frac{\\partial^2}{\\partial x^2}" Click="InsertTemplate_Click"/>
                                <Button x:Name="vectorButton" Style="{StaticResource ToolbarButton}" Content="⃗v" ToolTip="向量" Tag="\\vec{v}" Click="InsertTemplate_Click"/>
                                <Button x:Name="hatButton" Style="{StaticResource ToolbarButton}" Content="̂v" ToolTip="帽子符号" Tag="\\hat{v}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="v̅" ToolTip="平均值" Tag="\\overline{v}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="ṽ" ToolTip="波浪号" Tag="\\tilde{v}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="v̆" ToolTip="短波浪号" Tag="\\breve{v}" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="°" ToolTip="度" Tag="^\\circ" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="%" ToolTip="百分号" Tag="\\%" Click="InsertTemplate_Click"/>
                                <Button Style="{StaticResource ToolbarButton}" Content="‰" ToolTip="千分号" Tag="\\permil" Click="InsertTemplate_Click"/>
                            </ToolBar>
                        </Expander>
                    </WrapPanel>

                    <!-- 第三行：样式设置 -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="#F8FAFC"
                                CornerRadius="8"
                                Padding="8">
                            <ToolBar x:Name="styleToolbar"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                                <TextBlock x:Name="formulaColorLabel"
                                        Style="{StaticResource GroupTitle}"
                                        VerticalAlignment="Center"
                                        Margin="0"
                                        Text="公式颜色:"/>
                                <ComboBox x:Name="formulaColorComboBox"
                                        Width="100"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Margin="4,0,8,0"
                                        SelectionChanged="FormulaColorComboBox_SelectionChanged"/>
                                
                                <TextBlock x:Name="backgroundColorLabel"
                                        Style="{StaticResource GroupTitle}"
                                        VerticalAlignment="Center"
                                        Margin="0"
                                        Text="背景:"/>
                                <ComboBox x:Name="backgroundColorComboBox"
                                        Width="100"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Margin="4,0,8,0"
                                        SelectionChanged="BackgroundColorComboBox_SelectionChanged"/>
                                
                                <TextBlock x:Name="fontLabel"
                                        Style="{StaticResource GroupTitle}"
                                        VerticalAlignment="Center"
                                        Margin="0"
                                        Text="字体:"/>
                                <ComboBox x:Name="fontComboBox"
                                        Width="120"
                                        Height="28"
                                        VerticalAlignment="Center"
                                        Margin="4,0,8,0"
                                        SelectionChanged="FontComboBox_SelectionChanged"/>
                                
                                <TextBlock x:Name="fontSizeLabel"
                                        Style="{StaticResource GroupTitle}"
                                        VerticalAlignment="Center"
                                        Margin="0"
                                        Text="字号:"/>
                                <Slider x:Name="fontSizeSlider"
                                        Width="100"
                                        Minimum="12"
                                        Maximum="48"
                                        Value="24"
                                        VerticalAlignment="Center"
                                        Margin="4,0,8,0"
                                        ValueChanged="FontSizeSlider_ValueChanged"/>
                                <TextBlock x:Name="fontSizeDisplay"
                                        Text="24"
                                        Width="30"
                                        VerticalAlignment="Center"/>
                            </ToolBar>
                        </Border>

                        <Border Background="#F8FAFC"
                                CornerRadius="8"
                                Padding="8"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="zoomLabel"
                                        Style="{StaticResource GroupTitle}"
                                        VerticalAlignment="Center"
                                        Margin="0"
                                        Text="缩放:"/>
                                <Button x:Name="zoomOutButton"
                                        Style="{StaticResource ToolbarButton}"
                                        Content="−"
                                        ToolTip="缩小"
                                        Margin="4,0"
                                        Click="ZoomOutButton_Click"/>
                                <Slider x:Name="zoomSlider"
                                        Width="100"
                                        Minimum="50"
                                        Maximum="200"
                                        Value="100"
                                        VerticalAlignment="Center"
                                        Margin="4,0"
                                        ValueChanged="ZoomSlider_ValueChanged"/>
                                <Button x:Name="zoomInButton"
                                        Style="{StaticResource ToolbarButton}"
                                        Content="+"
                                        ToolTip="放大"
                                        Margin="4,0"
                                        Click="ZoomInButton_Click"/>
                                <TextBlock x:Name="zoomDisplay"
                                        Text="100%"
                                        Width="45"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：编辑器 -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    CornerRadius="12"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                    Opacity="0.06"
                                    BlurRadius="12"
                                    ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            CornerRadius="12,12,0,0"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <TextBlock x:Name="editorTitleTextBlock"
                                Text="LaTeX 编辑器"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#334155"/>
                    </Border>

                    <Border Grid.Row="1" Padding="12">
                        <ae:TextEditor x:Name="latexEditor"
                                    FontFamily="Consolas, 'Courier New', monospace"
                                    FontSize="14"
                                    ShowLineNumbers="True"
                                    LineNumbersForeground="#94A3B8"
                                    Background="#FFFFFF"
                                    Foreground="#1E293B"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1"
                        Width="8"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        Cursor="SizeWE"/>

            <!-- 右侧：预览 -->
            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    CornerRadius="12"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                    Opacity="0.06"
                                    BlurRadius="12"
                                    ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            CornerRadius="12,12,0,0"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <TextBlock x:Name="previewTitleTextBlock"
                                Text="公式预览"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#334155"/>
                    </Border>

                    <Border Grid.Row="1" Padding="12" Background="#FDFDFD">
                        <wv2:WebView2 x:Name="webView"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>