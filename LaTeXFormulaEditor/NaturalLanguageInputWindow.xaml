<Window x:Class="LaTeXFormulaEditor.NaturalLanguageInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaTeXFormulaEditor"
        mc:Ignorable="d"
        Title="自然语言转LaTeX"
        Height="300"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="输入自然语言描述：" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBox x:Name="inputTextBox" Grid.Row="1" 
                 AcceptsReturn="True" 
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Microsoft YaHei, Segoe UI"
                 FontSize="14"
                 Padding="10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="convertButton" Content="转换" Width="100" Height="30" Margin="5" Click="ConvertButton_Click"/>
            <Button x:Name="cancelButton" Content="取消" Width="100" Height="30" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
